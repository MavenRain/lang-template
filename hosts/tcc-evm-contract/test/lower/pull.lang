-- REFUSE_LOWER (slice K4d s2, C-K4d-1): an entry that makes a pull. The CALL lowering comes in slice K4d.
-- The pull is in a flagIf branch, thus the refusal looks in each branch.
state State := makeState (held : U256)
def asset : Addr := 0x00000000000000000000000000000000000000ee
def vault : Addr := 0x00000000000000000000000000000000000000cc
def init : State := makeState 0u

def take : (env : Env) -> (s : State) -> (f : Flag) -> (amount : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (f : Flag) (amount : U256) =>
    some (pair (makeState (u256Add (held s) amount)) (flagIf f (cons (pull asset (caller env) vault amount) nil) nil))
