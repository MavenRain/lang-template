-- Sample domain: a small inventory. Replace this file with the design of
-- your language. It is the source of truth. Run make plans to generate
-- domain/plans.mech from it (bin/gen-domain.mjs, domain/README.md).

-- The key of the JSON header. Set it to the name of your language.
def domainName : Text := textByte 115 (textByte 97 (textByte 109 (textByte 112 (textByte 108 (textByte 101 (textByte 45 (textByte 108 (textByte 97 (textByte 110 (textByte 103 (textEnd)))))))))))

-- The measure of a stock count.
mu Measure : Type 0 with
| measurePiece : Measure
| measureBox : Measure

-- A thing that the store keeps.
mu Item : Type 0 with
| makeItem : (name : Text) -> (measure : Measure) -> Item

-- The count of one item.
mu Stock : Type 0 with
| makeStock : (item : Item) -> (count : Nat) -> Stock
